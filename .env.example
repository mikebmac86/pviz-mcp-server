# pviz MCP Server Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# ============================================================================
# REQUIRED - API Authentication
# ============================================================================

# Your JWT token from api.pvizgenerator.com
# Get this from: https://pvizgenerator.com/account
PVIZ_JWT_TOKEN=your-jwt-token-here

# ============================================================================
# OPTIONAL - API Configuration
# ============================================================================

# Base URL for the pviz API
# Default: https://api.pvizgenerator.com
PVIZ_API_URL=https://api.pvizgenerator.com

# Polling configuration
# How often to check job status (seconds)
PVIZ_POLL_INTERVAL=5

# Maximum number of polling attempts (5 min default)
PVIZ_MAX_POLL_ATTEMPTS=60

# Minimum and maximum backoff sleep (seconds)
PVIZ_POLL_MIN_SLEEP=5
PVIZ_POLL_MAX_SLEEP=30

# Jitter ratio for polling randomization (0.0-1.0)
PVIZ_POLL_JITTER_RATIO=0.25

# ============================================================================
# OPTIONAL - HTTP Server Configuration
# ============================================================================

# Port for HTTP server
PORT=8080

# Host address (0.0.0.0 for all interfaces, 127.0.0.1 for local only)
HOST=0.0.0.0

# Logging level (debug, info, warning, error)
LOG_LEVEL=info

# Enable debug mode (true/false)
DEBUG=false

# CORS origins (comma-separated, use * to allow all)
# Example: https://example.com,https://app.example.com
# Leave empty to disable CORS
CORS_ORIGINS=


# ============================================================================
# NOTES
# ============================================================================
# 
# 1. NEVER commit your .env file to version control!
# 2. The .gitignore file is configured to exclude .env
# 3. For production, use secrets management:
#    - AWS: Secrets Manager or Parameter Store
#    - GCP: Secret Manager
#    - Azure: Key Vault
# 4. For Claude Desktop, you can set these in claude_desktop_config.json instead
# 5. For Docker, pass via -e flags or docker-compose environment section
